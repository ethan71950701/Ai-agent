<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates（升級成「推廣的常駐通知」）。舊系統不認得會忽略。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 只連 127.0.0.1（本機的操作指令），不連外網 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 助理面板的語音辨識（App 內即時辨識，才能畫音量動畫）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 設鬧鐘（一般權限，安裝時自動給）：沒有它，三星時鐘會拒絕 SET_ALARM；有了就能不開時鐘畫面直接設好 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 行事曆：助理直接新增事件（執行時權限；已 root 的手機用 pm grant 補上，不用跳系統詢問） -->
    <!-- 沒有 root 時改亮度、自動旋轉用（特殊權限：要使用者在設定裡允許一次） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 只需要看得到桌面上有圖示的 App（匯出 App 名稱清單用），不需要 QUERY_ALL_PACKAGES -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.android.calculator2" />
        <!-- 朗讀：要能找到系統的語音合成（TTS）引擎 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:label="PhoneAI Overlay"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:name=".App"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!-- 三星 Now Bar：宣告支援 Ongoing Activity。LiveBridge 2.1.4 的清單有這行，Now Bar 設定清單才會列出它（推測，待實測） -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 由 root 的 am start-foreground-service 或本 App 自己啟動；不開放給其他 App -->
        <!-- 裝置之間傳檔案的伺服器（使用者在「設定 → 傳檔案」開啟才會啟動）。 -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves files to the user's own paired devices on the local network at the user's request." />
        </service>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the live status and tap ripples of a local phone automation script." />
        </service>

        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AssistTheme" />

        <!-- 別的 App 的「分享」選單選 PhoneAI（檔案）：挑裝置後傳出去 -->
        <activity
            android:name=".FileShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_file_label"
            android:theme="@style/ConfirmTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 別的 App 的「分享」選單選 PhoneAI：文字填進助理面板（不自動送出） -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 桌面小工具：一鍵開助理面板並開始聽 -->
        <receiver
            android:name=".VoiceWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>

        <activity
            android:name=".MemoryActivity"
            android:exported="false" />

        <activity
            android:name=".BrowseActivity"
            android:exported="false" />

        <activity
            android:name=".FileSearchActivity"
            android:exported="false" />

        <activity
            android:name=".CommandsActivity"
            android:exported="false" />

        <activity
            android:name=".TaskDetailActivity"
            android:exported="false" />

        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <activity
            android:name=".TransferActivity"
            android:exported="false" />

        <activity
            android:name=".DiagActivity"
            android:exported="false" />

        <service
            android:name=".ScheduleJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />


        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".GuideActivity"
            android:exported="false" />

        <activity
            android:name=".MicTestActivity"
            android:exported="false" />

        <activity
            android:name=".ConfirmActivity"
            android:exported="false"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/ConfirmTheme" />

        <!-- 【實驗】直接顯示背景螢幕（不經影片壓縮）；用 su -c "am start -n com.phoneai.overlay/.DirectTestActivity" 開 -->
        <activity
            android:name=".DirectTestActivity"
            android:exported="false" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.phoneai.overlay.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.phoneai.overlay.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <provider
            android:name=".SurfaceProvider"
            android:authorities="com.phoneai.overlay.surface"
            android:exported="false" />

        <activity
            android:name=".TakeoverInputActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Material3.DayNight.Dialog" />

        <!-- 快速設定磁貼 -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_stat"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 預設數位助理（長按電源鍵） -->
        <service
            android:name=".AssistService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".NoRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 無障礙懸浮層（畫漣漪；只有在需要讀取畫面元件時才讀）。 -->
        <service
            android:name=".RippleAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_config" />
        </service>
    </application>
</manifest>
